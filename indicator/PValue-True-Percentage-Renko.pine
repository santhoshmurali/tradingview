//@version=6
indicator("PValue-True Percentage Renko", shorttitle = "PValue-True % Renko", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// Bricks are finalized only when their source bar closes. Percentage mode uses a symmetric logarithmic grid; the other modes use price-distance grids.
string calculationGroup = "Calculation"
string displayGroup = "Display"
string colorSchemeGroup = "Color Scheme"
string helpGroup = "Help"
string boxSizeType = input.string("Percentage", "Box Size Type", options = ["Percentage", "Absolute", "ATR Multiple", "Standard Deviation"], group = calculationGroup, tooltip = "Percentage compounds from each brick close. Absolute uses fixed price units. ATR Multiple and Standard Deviation adapt the size using confirmed-bar volatility.")
float brickPercentage = input.float(10.0, "Brick Size (%)", minval = 0.01, step = 0.5, group = calculationGroup, tooltip = "Used in Percentage mode. Each brick is this percentage of the prior brick close; 10 means a 1.10 multiplier.")
float absoluteBoxSize = input.float(1.0, "Absolute Box Size", minval = 0.00000001, step = 0.01, group = calculationGroup, tooltip = "Used in Absolute mode. Each brick spans this many chart-price units.")
int atrLength = input.int(14, "ATR Length", minval = 1, group = calculationGroup, tooltip = "Used in ATR Multiple mode to calculate the confirmed-bar ATR.")
float atrMultiplier = input.float(1.0, "ATR Multiplier", minval = 0.00000001, step = 0.1, group = calculationGroup, tooltip = "Used in ATR Multiple mode. Box size equals ATR multiplied by this value.")
int standardDeviationLength = input.int(20, "Standard Deviation Length", minval = 1, group = calculationGroup, tooltip = "Used in Standard Deviation mode to calculate close-price volatility.")
int standardDeviationMultiplier = input.int(1, "Standard Deviation Multiplier", options = [1, 2, 3], group = calculationGroup, tooltip = "Used in Standard Deviation mode. Box size equals the close-price standard deviation times 1, 2, or 3.")
string calculationBasis = input.string("High/Low", "Brick Calculation Basis", options = ["High/Low", "Close"], group = calculationGroup, tooltip = "High/Low uses each bar's high for rises and low for declines. Close uses the close for both.")
int reversalBricks = input.int(2, "Reversal Brick Count", options = [1, 2], group = calculationGroup, tooltip = "Two-brick reversals use the conventional non-overlapping Renko reversal brick.")
string candleDisplay = input.string("Visible", "Standard Chart Candles", options = ["Visible", "Dimmed", "Hidden"], group = displayGroup, tooltip = "Dimmed applies the selected transparency to candle bodies, borders, and wicks. Hidden makes them fully transparent.")
int dimmedCandleTransparency = input.int(30, "Dimmed Candle Transparency (%)", minval = 0, maxval = 100, group = displayGroup, tooltip = "0 is fully opaque and 100 is fully transparent. Applied to the body, border, and wick color.")
int renkoFillOpacity = input.int(85, "Renko Segment Fill Opacity (%)", minval = 0, maxval = 100, group = displayGroup, tooltip = "0 is invisible and 100 is fully opaque. Brick borders remain solid for readability.")
bool showBrickLabels = input.bool(false, "Show Brick Price & % Labels", group = displayGroup, tooltip = "Shows each retained brick's close and its signed percentage move.")
string labelTextSizeInput = input.string("tiny", "Label Text Size", options = ["tiny", "small", "normal"], group = displayGroup)
bool showWarning = input.bool(true, "Show Trading Warning", group = displayGroup)
string colorScheme = input.string("Highcharts 5.x", "Palette", options = ["Highcharts 5.x", "Highcharts 3.x", "Highcharts 2.x", "Luan", "R", "Viridis Color", "Dracula Theme", "University of Michigan-Dearborn", "Red-Yellow-Green", "Gazeta do Povo", "Hygge Color Palette", "Apple iMac 2021 - Front", "Apple iMac 2021 - Back", "University of Michigan Well-being", "Dracula UI", "Thiago", "Bootstrap 5.0"], group = colorSchemeGroup, tooltip = "Palette names and ordered color values are synchronized with ref/palettes.json.")
bool showHelp = input.bool(false, "Show Help", group = helpGroup)
string helpLocationInput = input.string("Top Right", "Help Location", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = helpGroup)
string helpTextSizeInput = input.string("small", "Help Text Size", options = ["tiny", "small", "normal"], group = helpGroup)

string labelSize = labelTextSizeInput == "tiny" ? size.tiny : labelTextSizeInput == "small" ? size.small : size.normal
string helpTextSize = helpTextSizeInput == "tiny" ? size.tiny : helpTextSizeInput == "small" ? size.small : size.normal
string helpPosition = helpLocationInput == "Top Left" ? position.top_left : helpLocationInput == "Bottom Right" ? position.bottom_right : helpLocationInput == "Bottom Left" ? position.bottom_left : position.top_right
float factor = 1.0 + brickPercentage / 100.0
float upwardSource = calculationBasis == "High/Low" ? high : close
float downwardSource = calculationBasis == "High/Low" ? low : close
float atrValue = ta.atr(atrLength)
float standardDeviationValue = ta.stdev(close, standardDeviationLength)
float activeBoxSize = boxSizeType == "Percentage" ? 0.0 : boxSizeType == "Absolute" ? absoluteBoxSize : boxSizeType == "ATR Multiple" ? atrValue * atrMultiplier : standardDeviationValue * standardDeviationMultiplier
bool boxSizeReady = boxSizeType == "Percentage" or (not na(activeBoxSize) and activeBoxSize > 0)

nextUp(float price, float boxSize) =>
    boxSizeType == "Percentage" ? price * factor : price + boxSize

nextDown(float price, float boxSize) =>
    boxSizeType == "Percentage" ? price / factor : price - boxSize

var array<color> activePalette = array.new_color()
if barstate.isfirst
    activePalette := switch colorScheme
        "Highcharts 5.x" => array.from(#7cb5ec, #434348, #90ed7d, #f7a35c, #8085e9, #f15c80, #e4d354, #2b908f, #f45b5b, #91e8e1)
        "Highcharts 3.x" => array.from(#2f7ed8, #0d233a, #8bbc21, #910000, #1aadce, #492970, #f28f43, #77a1e5, #c42525, #a6c96a)
        "Highcharts 2.x" => array.from(#4572A7, #AA4643, #89A54E, #80699B, #3D96AE, #DB843D, #92A8CD, #A47D7C, #B5CA92)
        "Luan" => array.from(#EAEFF2, #00AE4C, #FF84AF, #FFA700, #0072C4, #00A6E1, #FF0000, #73909E, #686E6F, #FA481B)
        "R" => array.from(#9E77A1, #9A8FBB, #8AA9C0, #7BC1BF, #7ED9B1, #B2ED90, #FDF57A)
        "Viridis Color" => array.from(#340042, #371865, #2f3776, #26547b, #20707b, #1f8f76, #2fac66, #5ec747, #a7db22, #fce51e)
        "Dracula Theme" => array.from(#282a36, #44475a, #f8f8f2, #6272a4, #8be9fd, #50fa7b, #ffb86c, #ff79c6, #bd93f9, #ff5555, #f1fa8c)
        "University of Michigan-Dearborn" => array.from(#171717, #022441, #FFC22E, #F9F9F9, #FFFFFF, #F5F7F9, #DADEE1)
        "Red-Yellow-Green" => array.from(#fb0007, #f38337, #fdb409, #ffff0b, #8cff28, #5bff27, #30c627)
        "Gazeta do Povo" => array.from(#FC6451, #FF932F, #FFD000, #00F7C6, #00DF87, #00C3E5)
        "Hygge Color Palette" => array.from(#F4F7EA, #E3DECF, #B7BDC0, #D5CECA, #B9B1A6, #58504B)
        "Apple iMac 2021 - Front" => array.from(#25476d, #10505b, #b72c31, #c7c8ca, #d48207, #e36942, #353a71)
        "Apple iMac 2021 - Back" => array.from(#a8bed2, #a4beb2, #eeb8b0, #c7c8ca, #eaca96, #e9aa95, #abacca)
        "University of Michigan Well-being" => array.from(#5797CD, #BB67A9, #12B492, #D2DF41, #48648A, #F37A3A, #FECC41, #28C0D6)
        "Dracula UI" => array.from(#15171b, #1d1e26, #282a36, #414558, #8a8f98, #f8f8f2, #80ffea, #8aff80, #ffca80, #ff80bf, #9580ff, #ff9580, #ffff80)
        "Thiago" => array.from(#FC6451, #FF932F, #FFD000, #00F7C6, #00DF87, #00C3E5, #FF76A4, #C872FF, #8B4513)
        => array.from(#316CF4, #6E757C, #3F8357, #CB444A, #F5C344, #5DC7EC, #222529)

color bullishColor = array.get(activePalette, 2)
color bearishColor = array.get(activePalette, 5)
color panelColor = array.get(activePalette, 0)
color accentColor = array.get(activePalette, 1)
contrastText(color backgroundColor) =>
    int brightness = math.round((color.r(backgroundColor) * 299 + color.g(backgroundColor) * 587 + color.b(backgroundColor) * 114) / 1000)
    brightness >= 150 ? color.black : color.white

color panelTextColor = contrastText(panelColor)
color candleColor = candleDisplay == "Dimmed" ? color.new(close >= open ? bullishColor : bearishColor, dimmedCandleTransparency) : candleDisplay == "Hidden" ? color.new(color.white, 100) : na

var array<box> brickBoxes = array.new_box()
var array<label> brickLabels = array.new_label()
var array<box> activeBrickSegment = array.new_box()
var float initialPrice = na
var float brickOpen = na
var float brickClose = na
var int direction = 0
var table warningTable = table.new(position.bottom_center, 1, 1, frame_color = accentColor, frame_width = 1, border_color = accentColor, border_width = 1)
var table helpTable = table.new(position.top_right, 1, 1, frame_color = accentColor, frame_width = 1, border_color = accentColor, border_width = 1)

drawBrick(float openPrice, float closePrice, int brickDirection) =>
    color brickColor = brickDirection == 1 ? bullishColor : bearishColor
    color brickTextColor = contrastText(brickColor)
    int activeBoxCount = array.size(activeBrickSegment)
    if activeBoxCount > 0 and box.get_left(array.get(activeBrickSegment, 0)) < bar_index
        for activeBoxIndex = 0 to activeBoxCount - 1
            box.set_right(array.get(activeBrickSegment, activeBoxIndex), bar_index)
        array.clear(activeBrickSegment)
    box newBox = box.new(left = bar_index, top = math.max(openPrice, closePrice), right = bar_index + 1, bottom = math.min(openPrice, closePrice), border_color = brickColor, border_width = 1, bgcolor = color.new(brickColor, 100 - renkoFillOpacity))
    array.push(brickBoxes, newBox)
    array.push(activeBrickSegment, newBox)
    if array.size(brickBoxes) > 500
        box.delete(array.shift(brickBoxes))
    if showBrickLabels
        float movePercent = (closePrice - openPrice) / openPrice * 100.0
        string moveText = (movePercent >= 0 ? "+" : "") + str.tostring(movePercent, "#.##") + "%"
        label newLabel = label.new(x = bar_index, y = closePrice, text = str.tostring(closePrice, format.mintick) + "\n" + moveText, yloc = yloc.price, color = brickColor, textcolor = brickTextColor, style = brickDirection == 1 ? label.style_label_down : label.style_label_up, size = labelSize)
        array.push(brickLabels, newLabel)
        if array.size(brickLabels) > 500
            label.delete(array.shift(brickLabels))

if barstate.isconfirmed and boxSizeReady
    if na(initialPrice)
        initialPrice := open
    else
        int activeBoxCount = array.size(activeBrickSegment)
        if activeBoxCount > 0
            for activeBoxIndex = 0 to activeBoxCount - 1
                box.set_right(array.get(activeBrickSegment, activeBoxIndex), bar_index + 1)
        if direction == 0
            if upwardSource >= nextUp(initialPrice, activeBoxSize)
                brickOpen := initialPrice
                brickClose := nextUp(initialPrice, activeBoxSize)
                direction := 1
                drawBrick(brickOpen, brickClose, direction)
                while upwardSource >= nextUp(brickClose, activeBoxSize)
                    brickOpen := brickClose
                    brickClose := nextUp(brickClose, activeBoxSize)
                    drawBrick(brickOpen, brickClose, direction)
            else if downwardSource <= nextDown(initialPrice, activeBoxSize)
                brickOpen := initialPrice
                brickClose := nextDown(initialPrice, activeBoxSize)
                direction := -1
                drawBrick(brickOpen, brickClose, direction)
                while downwardSource <= nextDown(brickClose, activeBoxSize)
                    brickOpen := brickClose
                    brickClose := nextDown(brickClose, activeBoxSize)
                    drawBrick(brickOpen, brickClose, direction)
        else if direction == 1
            while upwardSource >= nextUp(brickClose, activeBoxSize)
                brickOpen := brickClose
                brickClose := nextUp(brickClose, activeBoxSize)
                drawBrick(brickOpen, brickClose, direction)
            float reversalThreshold = reversalBricks == 1 ? brickOpen : nextDown(brickOpen, activeBoxSize)
            if downwardSource <= reversalThreshold
                if reversalBricks == 1
                    brickOpen := brickClose
                    brickClose := nextDown(brickOpen, activeBoxSize)
                else
                    brickClose := nextDown(brickOpen, activeBoxSize)
                direction := -1
                drawBrick(brickOpen, brickClose, direction)
                while downwardSource <= nextDown(brickClose, activeBoxSize)
                    brickOpen := brickClose
                    brickClose := nextDown(brickClose, activeBoxSize)
                    drawBrick(brickOpen, brickClose, direction)
        else
            while downwardSource <= nextDown(brickClose, activeBoxSize)
                brickOpen := brickClose
                brickClose := nextDown(brickClose, activeBoxSize)
                drawBrick(brickOpen, brickClose, direction)
            float reversalThreshold = reversalBricks == 1 ? brickOpen : nextUp(brickOpen, activeBoxSize)
            if upwardSource >= reversalThreshold
                if reversalBricks == 1
                    brickOpen := brickClose
                    brickClose := nextUp(brickOpen, activeBoxSize)
                else
                    brickClose := nextUp(brickOpen, activeBoxSize)
                direction := 1
                drawBrick(brickOpen, brickClose, direction)
                while upwardSource >= nextUp(brickClose, activeBoxSize)
                    brickOpen := brickClose
                    brickClose := nextUp(brickClose, activeBoxSize)
                    drawBrick(brickOpen, brickClose, direction)

// barcolor applies the selected transparency to the candle body, border, and wick; hidden candles may also need chart-style settings adjusted.
barcolor(candleColor, title = "Standard Chart Candles")

if barstate.islast
    if showWarning
        table.cell(warningTable, 0, 0, "Use this indicator as a supporting tool, not as the primary basis for trading decisions.", width = 30, text_color = panelTextColor, text_size = size.small, bgcolor = panelColor, text_halign = text.align_center)
    else
        table.clear(warningTable, 0, 0, 0, 0)
    table.set_position(helpTable, helpPosition)
    if showHelp
        string helpText = "True Percentage Renko\nBuilds confirmed Renko bricks over standard candles.\n\nChoose Percentage for compounding bricks, Absolute for fixed price-unit bricks, ATR Multiple for ATR-based sizing, or Standard Deviation for close-volatility sizing. Adaptive sizes update on each confirmed bar.\n\nInputs\nBox Size Type: Percentage, Absolute, ATR, or deviation\nPercentage / Absolute: selected fixed sizing value\nATR: length and multiplier\nDeviation: close length and 1x, 2x, or 3x multiplier\nBasis: High/Low or Close\nReversal: 1 or 2 bricks\nCandles: visible, dimmed, or hidden\nPalette: applies to all visuals"
        table.cell(helpTable, 0, 0, helpText, width = 30, text_color = panelTextColor, text_size = helpTextSize, bgcolor = panelColor, text_halign = text.align_left)
    else
        table.clear(helpTable, 0, 0, 0, 0)
